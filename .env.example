# Copy to .env. Authentication is SSO only: Caddy sets Remote-User after
# Authelia forward auth succeeds, and X-SSO-Proxy to the shared secret below.

# Must equal SSO_PROXY_SECRET in Caddy's environment. The app rejects identity
# headers unless X-SSO-Proxy matches, and rejects everyone if this is empty.
SSO_PROXY_SECRET=
# Map portal usernames to progress identities when they differ.
# Example: SSO_USERS=ifkash:enderboi,ananya:michu
SSO_USERS=

# Where progress, drafts, and run history live. A volume in the container.
DATA_DIR=/data

# The local runner's limits. LOCAL_WORKERS caps how many submissions run at
# once; the other two apply to each one. Zero memory leaves the per-process
# address-space limit off; the container's mem_limit bounds memory.
LOCAL_WORKERS=2
LOCAL_TIMEOUT_CEILING=180
LOCAL_MEMORY_MB=0
