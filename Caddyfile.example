# Add this block to the VM's Caddyfile, then reload Caddy from stdin, because
# the Caddyfile is bind-mounted as a single file and rewriting it in place
# orphans the mount:
#
#   docker exec -i caddy caddy validate --config - --adapter caddyfile < Caddyfile
#   docker exec -i caddy caddy reload   --config - --adapter caddyfile < Caddyfile
#
# Point an A record for the host at this machine first, or the ACME HTTP-01
# challenge cannot complete. SSO_PROXY_SECRET is the same value in Caddy's
# environment and in this app's .env.

os.ifkash.dev {
	# The snippet that gates the vhost behind Authelia forward auth and copies
	# Remote-User, as on gpu.ifkash.dev.
	import authelia

	# The app accepts Remote-User only when Caddy supplies the shared secret.
	request_header X-SSO-Proxy {env.SSO_PROXY_SECRET}

	encode zstd gzip

	reverse_proxy os:8000 {
		flush_interval -1
		transport http {
			response_header_timeout 30m
			read_timeout 30m
		}
	}
}
